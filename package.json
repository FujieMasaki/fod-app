{
  "name": "focus-on-dot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter @focus-on-dot/web dev",
    "build": "pnpm --filter @focus-on-dot/web build",
    "preview": "pnpm --filter @focus-on-dot/web preview",
    "lint": "eslint . && pnpm lint:naming",
    "lint:naming": "node scripts/check-naming.mjs",
    "check": "pnpm lint",
    "type-check": "pnpm --filter @focus-on-dot/web type-check",
    "test": "pnpm test:scripts && pnpm --filter @focus-on-dot/web test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:naming": "node --test scripts/check-naming.test.mjs",
    "test:watch": "pnpm --filter @focus-on-dot/web test:watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "eslint": "^9",
    "globals": "^17.12.0",
    "lefthook": "2.1.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0"
  }
}
