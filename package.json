{
  "name": "focus-on-dot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint && pnpm lint:naming",
    "lint:naming": "node scripts/check-naming.mjs",
    "check": "pnpm lint",
    "type-check": "tsc --noEmit --incremental false",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "ai:review": "node --env-file-if-exists=.env.local scripts/ai-review-local.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.35",
    "framer-motion": "^12.42.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "lefthook": "2.1.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
